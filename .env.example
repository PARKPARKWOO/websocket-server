AUTH_HOST=auth-service:9090
KAFKA_HOST=kafka:9092
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
MV_HOST=http://mirror-view-backend:8080

# Disabled by default so existing Mirror/BBR deployments remain compatible.
RESELL_WEBSOCKET_ENABLED=false

# Required only when RESELL_WEBSOCKET_ENABLED=true.
# Must exactly match Auth Passport.applicationId for Resell users.
RESELL_APPLICATION_ID=replace-with-resell-application-id

# Required only when enabled. Comma-separated exact origins; no wildcards.
WEBSOCKET_ALLOWED_ORIGINS=https://resell.platformholder.site,http://localhost:5173

# Optional Redis glob. Exactly one trailing wildcard is allowed.
RESELL_REDIS_CHANNEL_PREFIX=dev-resell:*
